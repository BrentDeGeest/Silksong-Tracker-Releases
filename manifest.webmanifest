{
  "name": "Silksong Map Tracker (unofficial fan app)",
  "short_name": "Silksong Map",
  "description": "An unofficial, free companion map for Hollow Knight: Silksong: every item, boss and shortcut, directions, guides and builds. Works offline.",
  "start_url": "./",
