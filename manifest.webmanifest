  "display": "standalone",
  "orientation": "any",
  "background_color": "#120c0d",
  "theme_color": "#120c0d",
  "icons": [
    { "src": "img/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "img/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
